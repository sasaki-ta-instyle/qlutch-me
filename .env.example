# Instagram Graph API
# 1) developers.facebook.com で App 作成（Type: Business）
# 2) Instagram Graph API を有効化し、@qlutchme の Business アカウントを
#    連携している Facebook Page に紐付ける
# 3) 長期アクセストークン（60 日）を発行し、この 2 つを埋める
IG_LONG_LIVED_TOKEN=
IG_USER_ID=

# Contact フォーム送信先（Resend 経由）
RESEND_API_KEY=
CONTACT_TO_EMAIL=i@qlutch.me
CONTACT_FROM_EMAIL=contact@qlutch.me
